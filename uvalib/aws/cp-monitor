                    stdscr.addstr(f"{status}")
                    stdscr.attroff(colors['SUCCESS'])
                elif status == 'Failed':
                    stdscr.attron(colors['FAILED'])
                    stdscr.addstr(f"{status}")
                    stdscr.attroff(colors['FAILED'])
                elif status == 'InProgress':
                    stdscr.attron(colors['INPROGRESS'])
                    stdscr.addstr(f"{status}")
                    stdscr.attroff(colors['INPROGRESS'])
                else:
                    stdscr.addstr(f"{status}")
            else:
                stdscr.addstr(f"{status}")
                
            stdscr.addstr(f" (Updated: {last_update})")
            row += 1
            
            # Show actions if available
            actions = exec_info.get('actions', [])
            if actions:
                for j, action in enumerate(actions):
                    if row >= height - 3: break
                    
                    action_name = action.get('name', 'Unknown action')
                    action_status = action.get('status', 'Unknown')
                    action_time = format_timestamp(action.get('lastUpdate', 'Unknown'))
                    
                    # Format each action with status and time
                    stdscr.addstr(row, 6, f"• {action_name}: ")
                    
                    # Color the action status
                    if colors:
                        if action_status == 'Succeeded':
                            stdscr.attron(colors['SUCCESS'])
                            stdscr.addstr(f"{action_status}")
                            stdscr.attroff(colors['SUCCESS'])
                        elif action_status == 'Failed':
                            stdscr.attron(colors['FAILED'])
                            stdscr.addstr(f"{action_status}")
                            stdscr.attroff(colors['FAILED'])
                        elif action_status == 'InProgress':
                            stdscr.attron(colors['INPROGRESS'])
                            stdscr.addstr(f"{action_status}")
                            stdscr.attroff(colors['INPROGRESS'])
                        else:
                            stdscr.addstr(f"{action_status}")
                    else:
                        stdscr.addstr(f"{action_status}")
                    
                    # Show last update time if available
                    if action_time and action_time != 'Unknown':
                        stdscr.addstr(f" ({action_time})")
                    
                    row += 1
                    
                    # Show error details if action failed
                    error_msg = action.get('error')
                    if error_msg and action_status == 'Failed':
                        if row >= height - 3: break
                        
                        # Wrap long error messages
                        if len(error_msg) > width - 12:
                            error_msg = error_msg[:width-15] + "..."
                            
                        stdscr.attron(curses.A_BOLD)
                        stdscr.addstr(row, 8, f"Error: {error_msg}")
                        stdscr.attroff(curses.A_BOLD)
                        row += 1
            
            # Show general error details for failed stages
            if status == 'Failed' and 'errorDetails' in exec_info and not actions:
                error_msg = exec_info['errorDetails'].get('message', 'Unknown error')
                stdscr.attron(curses.A_BOLD)
                stdscr.addstr(row, 4, f"Error: {error_msg[:width-10]}")  # Truncate if necessary
                stdscr.attroff(curses.A_BOLD)
                row += 1
            
            row += 1  # Space between stages
    
    # Add execution history section if available
    if 'executions' in state and state['executions']:
        executions = state['executions']
        
        # Check if we have room to display at least some execution history
        if row + 3 < height - 3:  # Need at least 3 rows: header, separator, and 1 execution
            stdscr.addstr(row, 0, " Execution History: ")
            stdscr.addstr(row + 1, 0, "-" * (width-1))
            row += 2
            
            # Show up to 5 recent executions
            for i, execution in enumerate(executions[:5]):
                if row >= height - 3:  # Leave space for footer
                    break
                    
                status = execution.get('status', 'Unknown')
                start_time = format_timestamp(execution.get('startTime', 'Unknown'))
                
                # Format the execution line
                exec_line = f"{i+1}. {start_time} - Status: "
                stdscr.addstr(row, 2, exec_line)
                
                # Add colored status
                if colors:
                    if status == 'Succeeded':
                        stdscr.attron(colors['SUCCESS'])
                    elif status == 'Failed':
                        stdscr.attron(colors['FAILED'])
                    elif status == 'InProgress':
                        stdscr.attron(colors['INPROGRESS'])
                
                stdscr.addstr(status)
                
                # Reset color
                if colors:
                    if status == 'Succeeded':
                        stdscr.attroff(colors['SUCCESS'])
                    elif status == 'Failed':
                        stdscr.attroff(colors['FAILED'])
                    elif status == 'InProgress':
                        stdscr.attroff(colors['INPROGRESS'])
                
                row += 1
    
    # Footer
    stdscr.addstr(height-1, 0, "Press any key to return to main view")
    stdscr.refresh()
    stdscr.getch()  # Wait for keypress
    
    # Reset timeout before returning to main view
    stdscr.timeout(1000)

def draw_no_pipelines_screen(stdscr, filter_pattern, colors=None):
    """Draw screen when no pipelines match the filter"""
    height, width = stdscr.getmaxyx()
    stdscr.clear()
    
    # Draw header
    header = " CodePipeline Monitor "
    stdscr.addstr(0, 0, "=" * (width-1))
    
    if colors:
        stdscr.attron(colors['HEADER'])
    stdscr.addstr(0, (width - len(header)) // 2, header)
    if colors:
        stdscr.attroff(colors['HEADER'])
    
    # Draw message
    message_lines = [
        f"No pipelines match the current filter: '{filter_pattern}'",
        "",
        "Press 'f' to change the filter pattern",
        "Press 'r' to refresh with current filter",
        "Press 'q' to quit"
    ]
    
    start_row = (height - len(message_lines)) // 2
    
    for i, line in enumerate(message_lines):
        if start_row + i < height - 1:
            if i == 0 and colors:
                stdscr.attron(colors['WARNING'] | curses.A_BOLD)
            
            stdscr.addstr(start_row + i, (width - len(line)) // 2, line)
            
            if i == 0 and colors:
                stdscr.attroff(colors['WARNING'] | curses.A_BOLD)
    
    # Footer
    footer = "q:Quit | r:Refresh | f:Filter"
    stdscr.addstr(height-1, 0, footer[:width-1])
    
    stdscr.refresh()

class PipelineMonitor:
    def __init__(self):
        self.states = {}
        self.update_queue = queue.Queue()
        self.executor = ThreadPoolExecutor(max_workers=5)
        self.last_refresh = time.time()
        self.refresh_interval = 30  # seconds
        self.priority_refresh_interval = 10  # seconds for active pipelines
        self.is_running = True
        self.pipelines = []
        self.initialized = False
        self.config = load_config()
        self.refresh_interval = self.config.get('refresh_interval', 30)
        # Track pipelines that need priority refresh (those in InProgress)
        self.priority_pipelines = set()
        self.last_priority_refresh = 0

    def start_background_refresh(self):
        """Start background refresh thread"""
        def refresh_worker():
            while self.is_running:
                try:
                    current_time = time.time()
                    
                    # Initial setup - fetch pipelines first
                    if not self.initialized:
                        self.update_queue.put(('status', "Initializing... fetching pipeline list"))
                        self.pipelines = get_pipelines()
                        
                        # Still initialize even if no pipelines found
                        self.update_queue.put(('pipelines', self.pipelines))
                        if not self.pipelines:
                            self.update_queue.put(('no_pipelines', self.config.get('pipeline_filter', '*')))
                        else:
                            self.update_queue.put(('status', f"Found {len(self.pipelines)} pipelines"))
                            # Fetch states only if pipelines exist
                            self.refresh_states(is_initial=True)
                        
                        self.initialized = True
                        self.last_refresh = time.time()
                    
                    # Check if we need to refresh priority pipelines
                    elif self.priority_pipelines and current_time - self.last_priority_refresh >= self.priority_refresh_interval:
                        self.refresh_priority_pipelines()
                        self.last_priority_refresh = current_time
                    
                    # Regular refresh cycle for all pipelines
                    elif current_time - self.last_refresh >= self.refresh_interval:
                        new_pipelines = get_pipelines()
                        # Update pipeline list regardless of whether it's empty
                        self.pipelines = new_pipelines
                        self.update_queue.put(('pipelines', self.pipelines))
                        
                        if not self.pipelines:
                            self.update_queue.put(('no_pipelines', self.config.get('pipeline_filter', '*')))
                        else:
                            # Only refresh states if pipelines exist
                            self.refresh_states(is_initial=False)
                            
                        self.last_refresh = current_time
                        
                    time.sleep(0.1)
                    
                except Exception as e:
                    self.update_queue.put(('error', f"Refresh thread error: {str(e)}"))
                    time.sleep(1)

        thread = threading.Thread(target=refresh_worker, daemon=True)
        thread.start()
        return thread

    def refresh_priority_pipelines(self):
        """Refresh only pipelines that are in InProgress status"""
        if not self.priority_pipelines:
            return

        self.update_queue.put(('status', f"Refreshing {len(self.priority_pipelines)} active pipelines..."))
        
        # Create a list of pipeline objects for priority pipelines
        priority_pipeline_objects = []
        for pipeline in self.pipelines:
            if pipeline['name'] in self.priority_pipelines:
                priority_pipeline_objects.append(pipeline)
                
        if not priority_pipeline_objects:
            return
            
        def fetch_priority_state(pipeline):
            try:
                name = pipeline['name']
                state = get_pipeline_state(name)
                
                # Check if this pipeline has completed and should be removed from priority list
                is_complete = False
                if state and isinstance(state, dict) and state.get('stages'):
                    # Check if all stages are complete
                    all_stages_complete = True
                    for stage in state['stages']:
                        status = stage.get('latestExecution', {}).get('status', '').upper()
                        if status == 'INPROGRESS':
                            all_stages_complete = False
                            break
                    
                    if all_stages_complete:
                        is_complete = True
                        # Remove from priority list if complete
                        self.priority_pipelines.discard(name)
                
                # Update the state
                self.update_queue.put(('state', (name, state)))
                
                # Update UI with completion status
                if is_complete:
                    self.update_queue.put(('status', f"Pipeline {name} completed"))
                    
            except Exception as e:
                self.update_queue.put(('error', f"Error fetching priority pipeline {name}: {str(e)}"))
                # If we can't fetch the state, remove from priority to avoid constant retries
                self.priority_pipelines.discard(name)
        
        # Submit all priority pipeline tasks to the executor
        for pipeline in priority_pipeline_objects:
            self.executor.submit(fetch_priority_state, pipeline)
            
        self.update_queue.put(('status', f"Refreshing {len(priority_pipeline_objects)} active pipelines..."))

    def refresh_states(self, is_initial=False):
        """Refresh all pipeline states"""
        try:
            # Get fresh pipeline list for normal refresh cycles
            if not is_initial:
                new_pipelines = get_pipelines()
                if new_pipelines:
                    self.pipelines = new_pipelines
                    self.update_queue.put(('pipelines', self.pipelines))
                else:
                    self.update_queue.put(('error', "No pipelines found during refresh"))
                    return
                    
            self.update_queue.put(('status', f"Refreshing {len(self.pipelines)} pipelines..."))
            
            def fetch_state(pipeline):
                try:
                    name = pipeline['name']
                    state = get_pipeline_state(name)
                    
                    # Verify we got valid state data
                    if not state or not isinstance(state, dict):
                        self.update_queue.put(('error', f"Invalid state returned for {name}"))
                        self.priority_pipelines.discard(name)  # Remove from priority if invalid
                    elif not state.get('stages'):
                        if not state.get('error'):
                            self.update_queue.put(('error', f"No stages found for {name}"))
                        self.priority_pipelines.discard(name)  # Remove from priority if no stages
                    else:
                        # Valid state with stages
                        self.update_queue.put(('state', (name, state)))
                        
                        # Check if any stage is in progress - if so, add to priority list
                        has_in_progress = False
                        for stage in state['stages']:
                            status = stage.get('latestExecution', {}).get('status', '').upper()
                            if status == 'INPROGRESS':
                                has_in_progress = True
                                break
                                
                        if has_in_progress:
                            self.priority_pipelines.add(name)
                        else:
                            self.priority_pipelines.discard(name)
                    
                except Exception as e:
                    self.update_queue.put(('error', f"Error fetching {name}: {str(e)}"))
                    self.priority_pipelines.discard(name)  # Remove from priority on error
                finally:
                    # Always update status to show progress
                    self.update_queue.put(('progress', name))
            
            # Submit all pipeline refresh tasks to the executor
            submitted = 0
            for pipeline in self.pipelines:
                self.executor.submit(fetch_state, pipeline)
                submitted += 1
                
            self.update_queue.put(('status', f"Submitted {submitted} pipeline updates"))
        except Exception as e:
            self.update_queue.put(('error', f"Refresh error: {str(e)}"))

    def update_filter(self, new_filter):
        """Update filter pattern and trigger refresh"""
        if new_filter and new_filter != self.config.get('pipeline_filter'):
            self.config = update_config(new_filter=new_filter)
            self.initialized = False  # Force re-initialization with new filter
            self.states = {}  # Clear existing states
            self.pipelines = []  # Clear existing pipelines
            
            # Immediately fetch new pipeline list with the new filter
            self.update_queue.put(('status', f"Applying new filter: {new_filter}"))
            try:
                new_pipelines = get_pipelines()
                self.pipelines = new_pipelines  # Always update pipelines list
                self.update_queue.put(('pipelines', self.pipelines))
                
                if not new_pipelines:
                    # Signal that no pipelines match the filter
                    self.update_queue.put(('no_pipelines', new_filter))
                else:
                    self.update_queue.put(('status', f"Found {len(new_pipelines)} pipelines with filter: {new_filter}"))
            except Exception as e:
                self.update_queue.put(('error', f"Error applying filter: {str(e)}"))
                
            # Force immediate refresh
            self.last_refresh = 0
            return True
        return False

def main(stdscr):
    # Setup
    curses.curs_set(0)
    curses.use_default_colors()
    selected_idx = 0
    scroll_offset = 0  # Track current scroll position
    status_msg = "Initializing..."
    operation_status = "Starting up..."
    pipelines = []
    processed_count = 0
    
    monitor = PipelineMonitor()
    refresh_thread = monitor.start_background_refresh()
    
    colors = setup_colors()  # Initialize colors
    
    # New state variable to track empty pipeline state
    no_pipelines_filter = None
    
    # Debug flag - set to True to enable debugging to file
    debug_mode = False
    if debug_mode:
        debug_file = open('/tmp/cp-monitor-debug.log', 'w')
    
    try:
        # Show initial loading screen
        draw_loading_screen(stdscr, f"Initializing AWS CodePipeline Monitor...\n"
                                  f"Loading data in background...\n"
                                  f"Please wait...")
        
        # Main UI loop starts immediately - no blocking operations
        while True:
            # Process any pending updates from background thread
            update_count = 0
            while not monitor.update_queue.empty():
                update_count += 1
                update_type, data = monitor.update_queue.get_nowait()
                
                if update_type == 'state':
                    pipeline_name, state = data
                    if debug_mode:
                        debug_file.write(f"Got state for {pipeline_name}: {state}\n")
                        debug_file.flush()
                    monitor.states[pipeline_name] = state
                elif update_type == 'pipelines':
                    pipelines = data
                    # Reset no_pipelines_filter if we got pipelines
                    if pipelines:
                        no_pipelines_filter = None
                    # Reset selection if the list changed
                    if selected_idx >= len(pipelines):
                        selected_idx = 0
                elif update_type == 'error':
                    status_msg = f"Error: {data}"
                elif update_type == 'status':
                    operation_status = data
                elif update_type == 'progress':
                    processed_count += 1
                    operation_status = f"Processed {processed_count}/{len(pipelines)} pipelines"
                elif update_type == 'no_pipelines':
                    no_pipelines_filter = data  # Store the filter that returned no results
                    status_msg = f"No pipelines match filter: '{data}'"

            # Calculate time until next refresh - show priority refresh if applicable
            if pipelines and monitor.priority_pipelines:
                next_refresh = min(
                    monitor.refresh_interval - (time.time() - monitor.last_refresh),
                    monitor.priority_refresh_interval - (time.time() - monitor.last_priority_refresh)
                )
            else:
                next_refresh = monitor.refresh_interval - (time.time() - monitor.last_refresh)
                
            if next_refresh < 0:
                next_refresh = 0
            
            # Draw the appropriate screen based on pipeline state
            if pipelines:
                # We have pipelines - draw normal screen
                no_pipelines_filter = None  # Clear no pipelines state
                
                # Draw screen and get updated scroll offset
                scroll_offset = draw_pipeline_status(
                    stdscr, pipelines, monitor.states, selected_idx, 
                    scroll_offset, status_msg, operation_status, next_refresh, colors
                )
                
            elif no_pipelines_filter:
                # We specifically know there are no matching pipelines - show special screen
                draw_no_pipelines_screen(stdscr, no_pipelines_filter, colors)
            else:
                # If no pipelines yet, keep showing the loading screen
                if update_count > 0:  # Only redraw if we had updates
                    draw_loading_screen(stdscr, f"Initializing AWS CodePipeline Monitor...\n"
                                             f"{operation_status}\n"
                                             f"{status_msg}")
            
            status_msg = None  # Clear status message after display
            
            # Handle input with short timeout for responsive UI
            stdscr.timeout(100)  # Short timeout for smooth updates
            key = stdscr.getch()
            
            if key == ord('q'):
                break
            elif key == ord('r'):
                operation_status = "Manual refresh triggered..."
                status_msg = "Refreshing all pipelines..."
                # Force immediate refresh
                monitor.states = {}
                monitor.last_refresh = 0
                processed_count = 0
                no_pipelines_filter = None  # Reset no pipelines state
                continue
            elif key == ord('f'):
                # Get current filter (whether there are pipelines or not)
                current_filter = monitor.config.get('pipeline_filter', '*')
                new_filter = show_filter_prompt(stdscr, current_filter)
                
                if new_filter and new_filter != current_filter:
                    status_msg = f"Changing filter to: {new_filter}"
                    operation_status = "Updating filter and refreshing..."
                    processed_count = 0
                    pipelines = []  # Clear current pipeline list to show loading state
                    monitor.states = {}  # Clear states
                    
                    # Update filter in monitor - this now does immediate refresh
                    if monitor.update_filter(new_filter):
                        # Show the user that we're working on it
                        draw_loading_screen(stdscr, f"Filter changed to: {new_filter}\n"
                                                 f"Refreshing pipeline list...\n"
                                                 f"Please wait...")
                        
                        # Wait a moment to ensure the UI shows the loading screen
                        time.sleep(0.5)
                continue
            elif key == 10 or key == 13 and pipelines:  # Handle Return/Enter key only if we have pipelines
                if selected_idx < len(pipelines):
                    name = pipelines[selected_idx]['name']
                    
                    # First make sure we have state data
                    if name not in monitor.states:
                        status_msg = f"No data for {name} yet, please wait..."
                        continue
                    
                    # Show detailed view - will wait for user keypress
                    show_pipeline_details(stdscr, name, monitor.states[name], colors)
                continue
            elif key == curses.KEY_UP:
                if selected_idx > 0:
                    selected_idx -= 1
            elif key == curses.KEY_DOWN:
                if pipelines and selected_idx < len(pipelines) - 1:
                    selected_idx += 1
            elif key == curses.KEY_PPAGE:  # Page Up
                # Move selection up by a page
                list_height = curses.LINES - 6
                selected_idx = max(0, selected_idx - list_height)
            elif key == curses.KEY_NPAGE:  # Page Down
                # Move selection down by a page
                list_height = curses.LINES - 6
                if pipelines:
                    selected_idx = min(len(pipelines) - 1, selected_idx + list_height)
            elif key == ord('j'):  # Vim-style down
                if pipelines and selected_idx < len(pipelines) - 1:
                    selected_idx += 1
            elif key == ord('k'):  # Vim-style up
                if selected_idx > 0:
                    selected_idx -= 1
            elif key == -1:  # Timeout
                continue
            
    except Exception as e:
        error_msg = f"Error: {type(e).__name__}\n\n{str(e)}\n\nPress any key to exit."
        draw_loading_screen(stdscr, error_msg)
        stdscr.getch()
    finally:
        monitor.is_running = False
        refresh_thread.join(timeout=1)
        monitor.executor.shutdown(wait=False)

if __name__ == "__main__":
    curses.wrapper(main)
