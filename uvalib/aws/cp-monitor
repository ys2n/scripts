            elif status == 'Failed':
                stdscr.attroff(colors['FAILED'])
            elif status == 'InProgress':
                stdscr.attroff(colors['INPROGRESS'])
                
        row += 1
    
    if 'lastDuration' in state:
        stdscr.addstr(row, 2, f"Duration: {state.get('lastDuration', 'Unknown')}")
        row += 1
        
    if 'lastTriggerType' in state:
