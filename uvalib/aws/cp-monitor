            stage_name = stage.get('stageName', 'Unknown stage')
            exec_info = stage.get('latestExecution', {})
            status = exec_info.get('status', 'Unknown')
            last_update = format_timestamp(exec_info.get('lastUpdateTime', 'Unknown'))
            
