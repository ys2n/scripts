    height, width = stdscr.getmaxyx()
    stdscr.clear()
    
    # Disable timeout for detail view
    stdscr.timeout(-1)  # Wait indefinitely for user input
    
    # Header
    title = f" Pipeline Details: {pipeline_name} "
    stdscr.addstr(0, 0, "=" * (width-1))
    
    if colors:
        stdscr.attron(colors['HEADER'])
    stdscr.addstr(0, (width - len(title)) // 2, title)
    if colors:
        stdscr.attroff(colors['HEADER'])
    
    # Basic pipeline info
    stdscr.addstr(2, 2, f"Status: {state.get('status', 'Unknown')}")
    stdscr.addstr(3, 2, f"Updated: {format_timestamp(state.get('updated', 'Unknown'))}")
    stdscr.addstr(4, 2, f"Created: {format_timestamp(state.get('created', 'Unknown'))}")
    
