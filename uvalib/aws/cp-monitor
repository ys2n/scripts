    """Get status of a specific stage by name"""
    for stage in stages:
        if stage.get('stageName', '').lower() == stage_name.lower():
            status = stage.get('latestExecution', {}).get('status', 'Unknown')
            # Debug any status issues - uncomment if needed
            # print(f"Found stage {stage_name}, status: {status}, data: {stage.get('latestExecution')}")
            return status
    return "N/A"

def setup_colors():
    """Initialize color pairs for the interface"""
    # Check if terminal supports color
    if curses.has_colors():
        curses.start_color()
        curses.use_default_colors()
        
        # Define color pairs
        # Color pairs are defined as: (pair_number, foreground, background)
        curses.init_pair(1, curses.COLOR_GREEN, -1)    # Success
        curses.init_pair(2, curses.COLOR_RED, -1)      # Error/Failed
        curses.init_pair(3, curses.COLOR_YELLOW, -1)   # Warning
        curses.init_pair(4, curses.COLOR_BLUE, -1)     # Info
        curses.init_pair(5, curses.COLOR_CYAN, -1)     # Header
        curses.init_pair(6, curses.COLOR_WHITE, -1)    # Default
        curses.init_pair(7, 209, -1)                   # Orange (for InProgress)
        
        # Return color mapping
        return {
            'SUCCESS': curses.color_pair(1),
            'ERROR': curses.color_pair(2),
            'FAILED': curses.color_pair(2),
            'WARNING': curses.color_pair(3),
            'INPROGRESS': curses.color_pair(7) | curses.A_BLINK,  # Orange + blinking
            'INFO': curses.color_pair(4),
            'HEADER': curses.color_pair(5),
            'DEFAULT': curses.color_pair(6)
        }
    return {}  # Return empty dict if colors not supported

def get_status_color(status, colors):
    """Get the appropriate color pair for a status"""
    if not colors:
        return 0
        
    status = status.upper() if status else ""
    
    if status == 'SUCCEEDED':
        return colors['SUCCESS']
    elif status == 'FAILED':
        return colors['FAILED'] 
    elif status == 'INPROGRESS':
        return colors['INPROGRESS']  # This now has A_BLINK attribute too
    elif status == 'ERROR':
        return colors['ERROR']
    else:
        return colors.get('DEFAULT', 0)

def draw_pipeline_status(stdscr, pipelines, states, selected_idx, scroll_offset=0, status_msg=None, operation_status=None, next_refresh=None, colors=None):
    """Draw pipeline status screen with scrolling support"""
    height, width = stdscr.getmaxyx()
    stdscr.clear()
    
    # Define minimum column widths for stage status columns - add one space to each
    min_source_width = 9  # Increased from 8
    min_build_width = 9   # Increased from 8
    min_deploy_width = 9  # Increased from 8
    min_separators_width = 10  # " | " appears 3 times
    
    # Calculate available width for all columns
    available_width = width - 1  # Leave 1 char for potential scrollbar
    
    # First, allocate minimum space for status columns and separators
    min_required_width = min_source_width + min_build_width + min_deploy_width + min_separators_width
    
    # Determine pipeline name column width based on remaining space
    pipeline_width = max(10, available_width - min_required_width)
    
    # If we have less width than required, reduce pipeline name width further
    if available_width < min_required_width + 10:  # 10 is minimum desired pipeline name width
        # Not enough width - use strict minimums and truncate pipeline name heavily if needed
        source_width = min_source_width
        build_width = min_build_width
        deploy_width = min_deploy_width
        pipeline_width = max(5, available_width - min_required_width)  # Ensure at least 5 chars for name
    else:
        # We have sufficient width
        source_width = min_source_width
        build_width = min_build_width
        deploy_width = min_deploy_width
        pipeline_width = available_width - min_required_width  # Give all extra space to pipeline name
    
    # Header with refresh timer
    refresh_info = f" | Next refresh in {int(next_refresh)}s" if next_refresh else ""
    header = f" CodePipeline Monitor | Updated: {datetime.now().strftime('%H:%M:%S')}{refresh_info} "
    stdscr.addstr(0, 0, "=" * (width-1))
    
    if colors:
        stdscr.attron(colors['HEADER'])
    if len(header) < width:
        stdscr.addstr(0, (width - len(header)) // 2, header)
    if colors:
        stdscr.attroff(colors['HEADER'])
    
    # Status message area - with boundary check
    if status_msg and height > 2:
        stdscr.attron(curses.A_BOLD)
        msg = f" Status: {status_msg} "[:width-1]
        stdscr.addstr(1, 0, msg)
        stdscr.attroff(curses.A_BOLD)
    
    # Table header - adjust to fit available width with wider status columns
    if height > 3:
        header_line = f" {'Pipeline Name':<{pipeline_width}} | {'Source':<{source_width}} | {'Build':<{build_width}} | {'Deploy':<{deploy_width}}"
        if colors:
            stdscr.attron(colors['HEADER'] | curses.A_BOLD)
        else:
            stdscr.attron(curses.A_BOLD)
            
        stdscr.addstr(2, 0, header_line[:width-1])
        
        if colors:
            stdscr.attroff(colors['HEADER'] | curses.A_BOLD)
        else:
            stdscr.attroff(curses.A_BOLD)
            
        stdscr.addstr(3, 0, "-" * (width-1))
    
    # Calculate visible pipelines accounting for scroll
    list_height = height - 6  # Reserve space for headers, footer and status lines
    scroll_max = max(0, len(pipelines) - list_height)
    
    # Adjust scroll offset to keep selected item visible
    if selected_idx < scroll_offset:
        scroll_offset = selected_idx
    elif selected_idx >= scroll_offset + list_height:
        scroll_offset = selected_idx - list_height + 1
    
    # Cap scroll offset
    scroll_offset = max(0, min(scroll_max, scroll_offset))
    
    # Show scrollbar if needed
    if len(pipelines) > list_height:
        # Calculate scrollbar metrics
        scrollbar_height = max(3, int(list_height * list_height / len(pipelines)))
        scrollbar_pos = min(list_height - scrollbar_height, 
                          int(scroll_offset * list_height / len(pipelines)))
        
        # Draw scrollbar
        for i in range(list_height):
            is_thumb = i >= scrollbar_pos and i < scrollbar_pos + scrollbar_height
            stdscr.addstr(i + 4, width - 1, "█" if is_thumb else "│")
    
    # Pipeline list as table - only the visible portion
    visible_pipelines = pipelines[scroll_offset:scroll_offset + list_height]
    
    for idx, pipeline in enumerate(visible_pipelines):
        row_pos = idx + 4  # Start after table header and separator
        actual_idx = idx + scroll_offset  # Actual index in the full pipelines list
        name = pipeline['name']
        orig_name = name  # Store original name for state lookup
        
        # Always truncate name to pipeline_width to ensure proper formatting
        if len(name) > pipeline_width:
            name = name[:max(0, pipeline_width-3)] + "..."
        else:
            # Pad name to full width for proper alignment
            name = name.ljust(pipeline_width)
        
        # Apply highlight if selected
        if actual_idx == selected_idx:
            stdscr.attron(curses.A_REVERSE)
        
        # Get cached state or show loading - use original name for lookup
        state = states.get(orig_name, {
            'stages': [], 
            'error': None,
            'status': 'Loading...',
            'updated': datetime.now().isoformat(),
            'created': 'Unknown'
        })
        
        # If there's an error, show it in all columns
        if state.get('error'):
            col1 = "ERROR"
            col2 = "ERROR"
            col3 = "ERROR"
        elif not state.get('stages'):
            col1 = "Loading"
            col2 = "Loading"
            col3 = "Loading"
        else:
            # Extract status for each standard stage
            col1 = get_stage_status(state['stages'], "source")
            col2 = get_stage_status(state['stages'], "build")
            col3 = get_stage_status(state['stages'], "deploy")
            
            # Try common stage name variations
            if col1 == "N/A":
                for alt_name in ["Source", "checkout", "Checkout"]:
                    col1 = get_stage_status(state['stages'], alt_name)
                    if col1 != "N/A":
                        break
                        
            if col2 == "N/A":
                for alt_name in ["Build", "compile", "Compile", "Test", "test"]:
                    col2 = get_stage_status(state['stages'], alt_name)
                    if col2 != "N/A":
                        break
                        
            if col3 == "N/A":
                for alt_name in ["Deploy", "deployment", "Deployment", "Production"]:
                    col3 = get_stage_status(state['stages'], alt_name)
                    if col3 != "N/A":
                        break
        
        try:
            # Draw name column with exact width
            stdscr.addstr(row_pos, 0, f" {name[:pipeline_width]} ")
            
            # Add separators and status columns with precise positioning
            col_pos = pipeline_width + 2  # Starting position after name column plus space
            
            # Source column
            stdscr.addstr(row_pos, col_pos, "| ")
            col_pos += 2
            
            if colors:
                stdscr.attron(get_status_color(col1, colors))
            stdscr.addstr(row_pos, col_pos, f"{col1:<{source_width}}")
            if colors:
                stdscr.attroff(get_status_color(col1, colors))
            col_pos += source_width
            
            # Build column
            stdscr.addstr(row_pos, col_pos, " | ")
            col_pos += 3
            
            if colors:
                stdscr.attron(get_status_color(col2, colors))
            stdscr.addstr(row_pos, col_pos, f"{col2:<{build_width}}")
            if colors:
                stdscr.attroff(get_status_color(col2, colors))
            col_pos += build_width
            
            # Deploy column
            stdscr.addstr(row_pos, col_pos, " | ")
            col_pos += 3
            
            if colors:
                stdscr.attron(get_status_color(col3, colors))
            stdscr.addstr(row_pos, col_pos, f"{col3:<{deploy_width}}")
            if colors:
                stdscr.attroff(get_status_color(col3, colors))
        except curses.error:
            # Handle potential curses errors from drawing beyond screen boundaries
            pass
            
        # Turn off highlight
        if actual_idx == selected_idx:
            stdscr.attroff(curses.A_REVERSE)
    
    # Details for selected pipeline
    if selected_idx < len(pipelines) and height > 5:
        # Use original full name for details
        name = pipelines[selected_idx]['name']
        state = states.get(name, {})
        
        if state.get('error'):
            details = f" Error: {state['error']}"
        else:
            details = f" Last Updated: {state.get('updated', 'Unknown')} | Created: {state.get('created', 'Unknown')}"
        
        stdscr.addstr(height-2, 0, details[:width-1])
    
    # Footer with help - ensure it fits on screen
    if height > 1:
        if width < 80:  # For narrow screens, use shorter help text
            footer = "q:Quit | ↑↓:Nav | r:Refresh | f:Filter | Enter:View"
        else:
            footer = "q:Quit | ↑↓:Navigate | PgUp/PgDn:Scroll | r:Refresh | f:Filter | Return:View Details"
        
        footer = footer[:width-2]  # Leave space for scrollbar
        stdscr.addstr(height-1, 0, footer)
    
    # Operation status line - avoid last column and check height
    if operation_status and height > 2:
        status_line = f"Status: {operation_status}"[:width-1]
        stdscr.addstr(height-2, 0, status_line)
    
    # Show scroll position if scrolling with proper positioning for narrow screens
    if len(pipelines) > list_height:
        scroll_info = f"{scroll_offset+1}-{min(scroll_offset+list_height, len(pipelines))}/{len(pipelines)}"
        info_len = len(scroll_info)
        
        # Make sure we have space for the scroll info
        if width > info_len + 1:
            stdscr.addstr(height-1, width - info_len - 1, scroll_info)
    
    stdscr.refresh()
    return scroll_offset  # Return the new scroll offset

def format_timestamp(timestamp_str):
    """Format a timestamp string to a more readable format"""
    if not timestamp_str or timestamp_str == 'Unknown':
        return 'Unknown'
        
    try:
        # Try to parse and format ISO timestamp if available
        if 'T' in timestamp_str:
            # Parse ISO 8601 format
            dt = datetime.fromisoformat(timestamp_str.replace('Z', '+00:00'))
            return dt.strftime('%Y-%m-%d %H:%M:%S')
    except Exception:
        pass
        
    # Return original if parsing failed
    return timestamp_str

def show_pipeline_details(stdscr, pipeline_name, state, colors=None):
