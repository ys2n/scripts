            stdscr.addstr(row, 4, f"Commit: {rev_id}")
            row += 1
            
        if 'revisionAuthor' in commit_info and commit_info['revisionAuthor']:
            stdscr.addstr(row, 4, f"Author: {commit_info['revisionAuthor']}")
            row += 1
            
        if 'revisionSummary' in commit_info and commit_info['revisionSummary']:
