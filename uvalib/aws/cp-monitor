class PipelineError(Exception):
    """Custom exception for pipeline operations"""
    pass

def resolve_aws_command(cmd_args):
    """Prefix an aws CLI command with aws-vault if needed.

    Prefers credentials already in the environment (e.g. AWS_ACCESS_KEY_ID or
    AWS_PROFILE, such as inside an `aws-vault exec` session); otherwise falls
    back to `aws-vault exec $AWS_VAULT_PROFILE`. Mirrors the aws_run helper in
    ./alb-state, ./mandala-logs, and ./scan-alerts -- the interactive shell's
    `aws` alias to aws-vault is not inherited by this subprocess.
    """
    if os.environ.get('AWS_ACCESS_KEY_ID') or os.environ.get('AWS_PROFILE'):
        return cmd_args
    if shutil.which('aws-vault'):
        profile = os.environ.get('AWS_VAULT_PROFILE', 'staging')
        return ['aws-vault', 'exec', profile, '--'] + cmd_args
    return cmd_args

def execute_aws_command(cmd_args):
    """Execute AWS CLI command with error handling"""
    try:
        result = subprocess.run(
            resolve_aws_command(cmd_args),
            capture_output=True,
            text=True,
            check=True
        )
        return json.loads(result.stdout)
    except subprocess.CalledProcessError as e:
        raise PipelineError(f"AWS CLI error: {e.stderr}")
    except json.JSONDecodeError as e:
        raise PipelineError(f"Invalid JSON response: {e}")

def load_config():
    """Load configuration from config file"""
    config_path = os.path.join(os.path.dirname(__file__), 'config.json')
    try:
        with open(config_path) as f:
            return json.load(f)
    except Exception as e:
        return {'pipeline_filter': '*uva-drupal*'}  # Default config

def update_config(new_filter=None):
    """Update configuration file with new settings"""
    config_path = os.path.join(os.path.dirname(__file__), 'config.json')
    try:
        # Load existing config or create default
        try:
            with open(config_path) as f:
                config = json.load(f)
        except (FileNotFoundError, json.JSONDecodeError):
            config = {'pipeline_filter': '*', 'refresh_interval': 30}
        
        # Update with new values
        if new_filter:
            # Add wildcards if none present
            if '*' not in new_filter and '?' not in new_filter:
                new_filter = f"*{new_filter}*"
            
            config['pipeline_filter'] = new_filter
            
        # Write back to file
        with open(config_path, 'w') as f:
            json.dump(config, f, indent=4)
            
        return config
    except Exception as e:
        raise Exception(f"Failed to update config: {str(e)}")

def show_filter_prompt(stdscr, old_filter):
    """Show prompt to change filter pattern"""
    height, width = stdscr.getmaxyx()
    
    # Draw prompt box
    prompt_h = 7  # Increased height to accommodate the help text
    prompt_w = min(60, width - 4)
    prompt_y = (height - prompt_h) // 2
    prompt_x = (width - prompt_w) // 2
    
    # Create a new window for the prompt
    prompt_win = curses.newwin(prompt_h, prompt_w, prompt_y, prompt_x)
    prompt_win.box()
    
    # Draw prompt content
    prompt_win.addstr(1, 2, f"Current filter: {old_filter}")
    prompt_win.addstr(2, 2, "Enter new filter pattern:")
    prompt_win.addstr(3, 2, "(Wildcards * ? will be added if none present)")
    prompt_win.refresh()
    
    # Create input window (window within the prompt window)
    input_win = curses.newwin(1, prompt_w-6, prompt_y+4, prompt_x+3)
    input_win.keypad(True)
    
    # Initialize input handling
    curses.curs_set(1)  # Show cursor
    curses.echo()       # Show typed characters
    
    # Get user input
    new_filter = input_win.getstr(0, 0).decode('utf-8')
    
    # Reset terminal settings
    curses.noecho()
    curses.curs_set(0)  # Hide cursor
    
    # Return empty string if user just pressed Enter
    if not new_filter or new_filter.strip() == '':
        return None
    
    # Clean up any leading/trailing whitespace
    new_filter = new_filter.strip()
        
    return new_filter

def get_pipelines():
    """Get list of CodePipeline pipelines"""
    try:
        data = execute_aws_command(['aws', 'codepipeline', 'list-pipelines'])
        pipelines = data['pipelines']
        
        # Filter pipelines based on config
        config = load_config()
        pattern = config.get('pipeline_filter', '*')
        return [p for p in pipelines if fnmatch.fnmatch(p['name'], pattern)]
    except PipelineError as e:
        return []

def get_pipeline_executions(pipeline_name, max_items=5):
    """Get recent executions of a pipeline"""
    try:
        cmd = ['aws', 'codepipeline', 'list-pipeline-executions', '--pipeline-name', pipeline_name, '--max-items', str(max_items)]
        data = execute_aws_command(cmd)
        
        executions = data.get('pipelineExecutionSummaries', [])
        return executions
    except PipelineError as e:
        return []
    except Exception as e:
        return []

def get_pipeline_execution_details(pipeline_name, execution_id):
    """Get detailed information about a specific pipeline execution"""
    try:
        cmd = ['aws', 'codepipeline', 'get-pipeline-execution', 
               '--pipeline-name', pipeline_name, 
               '--pipeline-execution-id', execution_id]
        data = execute_aws_command(cmd)
        
        return data.get('pipelineExecution', {})
    except Exception as e:
        return {'error': str(e)}

def extract_stage_details_from_execution(execution):
    """Extract stage details from execution data"""
    result = {}
    
    # Get stage states from the execution if available
    stage_states = execution.get('stageStates', [])
    for stage in stage_states:
        stage_name = stage.get('stageName')
        if not stage_name:
            continue
            
        # Get action states for this stage
        action_states = stage.get('actionStates', [])
        actions = []
        
        for action in action_states:
            action_name = action.get('actionName', 'Unknown')
            last_status = action.get('latestExecution', {}).get('status', 'Unknown')
            last_update = action.get('latestExecution', {}).get('lastStatusChange')
            
            # Get error message if available
            error_details = action.get('latestExecution', {}).get('errorDetails', {})
            error_message = error_details.get('message') if error_details else None
            
            # Extract any output variables/artifacts
            output = action.get('latestExecution', {}).get('output', {})
            output_artifacts = output.get('outputArtifacts', [])
            
            actions.append({
                'name': action_name,
                'status': last_status,
                'lastUpdate': last_update,
                'error': error_message,
                'outputArtifacts': output_artifacts
            })
        
        # Store the stage details
        result[stage_name] = {
            'actions': actions,
            'lastUpdateTime': stage.get('latestExecution', {}).get('lastStatusChange'),
            'status': stage.get('latestExecution', {}).get('status', 'Unknown'),
            'inboundTransitions': stage.get('inboundTransitionState', {})
        }
    
    return result

def enrich_pipeline_state(pipeline_name, state):
    """Add execution history details to pipeline state"""
    if 'error' in state and state['error']:
        return state  # Don't try to enrich state if there was an error
        
    try:
        executions = get_pipeline_executions(pipeline_name, max_items=5)
        
        if executions:
            # Add executions list to state
            state['executions'] = executions
            
            # Add the most recent execution details to state
            latest = executions[0]
            execution_id = latest.get('pipelineExecutionId')
            
            # Extract stage information directly from execution data
            if execution_id:
                # Set stage_details from the executions data
                latest_stage_details = extract_stage_details_from_execution(latest)
                state['stageDetails'] = latest_stage_details
                
                # Get detailed execution information 
                execution_details = get_pipeline_execution_details(pipeline_name, execution_id)
                state['executionDetails'] = execution_details
                
                # Enhance stage information with execution details
                if 'stages' in state and 'stageDetails' in state:
                    for stage in state['stages']:
                        stage_name = stage.get('stageName')
                        if stage_name in state['stageDetails']:
                            # Enhance stage with details from execution
                            details = state['stageDetails'][stage_name]
                            
                            # Add action details to stage execution
                            if 'latestExecution' not in stage:
                                stage['latestExecution'] = {}
                            
                            stage['latestExecution']['actions'] = details.get('actions', [])
                            
                            # Make sure we have timestamp info
                            if 'lastUpdateTime' in details and details['lastUpdateTime']:
                                stage['latestExecution']['lastUpdateTime'] = details['lastUpdateTime']
            
                # Add commit info if available
                if 'artifactRevisions' in execution_details:
                    # Add commit info to stage details
                    for artifact in execution_details.get('artifactRevisions', []):
                        revision_info = {
                            'revisionId': artifact.get('revisionId', ''),
                            'revisionUrl': artifact.get('revisionUrl', ''),
                            'revisionSummary': artifact.get('revisionSummary', ''),
                            'revisionAuthor': artifact.get('revisionAuthor', '')
                        }
                        state['commitInfo'] = revision_info
            
            # Add last start time, status, etc. to the main state info for quick access
            state['lastStartTime'] = latest.get('startTime', 'Unknown')
            state['lastStatus'] = latest.get('status', 'Unknown')
            
            # If there was a trigger, add that info
            if 'trigger' in latest:
                trigger_type = latest['trigger'].get('triggerType', 'Unknown')
                state['lastTriggerType'] = trigger_type
                
                # Add specific details based on trigger type
                if trigger_type == 'GitPush':
                    state['lastTriggerDetail'] = f"Git: {latest['trigger'].get('gitPushDetails', {}).get('repositoryName', 'Unknown')}"
                elif trigger_type == 'WebhookV2':
                    state['lastTriggerDetail'] = f"Webhook: {latest['trigger'].get('webhookV2Details', {}).get('event', 'Unknown')}"
                elif trigger_type == 'Manual':
                    state['lastTriggerDetail'] = f"Manual by: {latest['trigger'].get('triggerDetail', 'Unknown user')}"
                else:
                    state['lastTriggerDetail'] = latest['trigger'].get('triggerDetail', 'Unknown')
            
            # Calculate execution duration if available
            if 'startTime' in latest and 'lastUpdateTime' in latest:
                start = latest['startTime']
                end = latest.get('lastUpdateTime', datetime.now(start.tzinfo))
                duration = end - start
                # Format duration as minutes:seconds
                minutes, seconds = divmod(duration.seconds, 60)
                state['lastDuration'] = f"{minutes}m {seconds}s"
                
                # If still in progress, note that the duration is ongoing
                if latest.get('status') == 'InProgress':
                    state['lastDuration'] += " (ongoing)"
            
        return state
    except Exception as e:
        # Don't fail if we can't get execution history
        state['executionError'] = str(e)
        return state

def get_pipeline_state(pipeline_name):
    """Get current state of a pipeline"""
    try:
        data = execute_aws_command(['aws', 'codepipeline', 'get-pipeline-state', '--name', pipeline_name])
        
        # Validate response structure
        if not isinstance(data, dict):
            raise PipelineError(f"Invalid response format for pipeline {pipeline_name}")
            
        # Extract stages with validation
        stages = data.get('stageStates', [])
        if not isinstance(stages, list):
            raise PipelineError(f"Invalid stages format for pipeline {pipeline_name}")
            
        # For each stage, ensure it has the required structure
        for stage in stages:
            if not isinstance(stage, dict):
                continue
            if 'latestExecution' not in stage:
                stage['latestExecution'] = {'status': 'Unknown'}
            if 'stageName' not in stage:
                stage['stageName'] = 'Unknown'

        state = {
            'stages': stages,
            'error': None,
            'status': data.get('pipelineExecutionId', 'Unknown'),
            'updated': data.get('updated', datetime.now().isoformat()),
            'created': data.get('created', 'Unknown')
        }
        
        # Enrich with execution history
        state = enrich_pipeline_state(pipeline_name, state)
        
        return state
        
    except PipelineError as e:
        return {
            'stages': [],
            'error': str(e),
            'status': 'ERROR',
            'updated': datetime.now().isoformat(),
            'created': 'Unknown'
        }
    except Exception as e:
        return {
            'stages': [],
            'error': f"Unexpected error: {str(e)}",
            'status': 'ERROR',
            'updated': datetime.now().isoformat(),
            'created': 'Unknown'
        }

def draw_loading_screen(stdscr, message):
    """Draw a simple loading screen with error formatting"""
    height, width = stdscr.getmaxyx()
    stdscr.clear()
    
    # Draw border - avoid last column
    stdscr.addstr(0, 0, "=" * (width-1))
    stdscr.addstr(height-1, 0, "=" * (width-1))
    
    # Format multi-line messages
    lines = message.split('\n')
    start_row = (height - len(lines)) // 2
    
    for i, line in enumerate(lines):
        if start_row + i < height - 1:  # Avoid bottom line
            # Center each line, avoid last column
            start_col = (width - len(line)) // 2
            safe_line = line[:width-1]  # Truncate if too long
            stdscr.addstr(start_row + i, start_col, safe_line)
    
    stdscr.refresh()

