{
  "pipeline_filter": "*uva-drupal*",
  "refresh_interval": 30,
  "favorites": {
    "drupal-prod": {
      "profile": "staging",
      "target_group": "alb-library-drupal-production"
    },
    "drupal-staging": {
      "profile": "staging",
      "target_group": "alb-library-drupal-staging"
    },
    "dh-prod": {
      "profile": "staging",
      "target_group": "alb-dh-drupal-production"
    },
    "alb-dsf": {
      "profile": "staging",
      "target_group": "alb-dsf-drupal-production"
    }
  },
  "notifications": {
    "topic_arn": "arn:aws:sns:us-east-1:115119339709:uva-site-urgent-production",
    "subscription_arn": "arn:aws:sns:us-east-1:115119339709:uva-site-urgent-production:b45cd604-0148-4598-a692-04552696ef05",
    "services": [
      "library-drupal",
      "mandala-drupal",
      "dh-drupal",
      "dsf-drupal"
    ],
    "environments": [
      "production"
    ],
    "prefix_templates": [
      "uva-{service}-{environment}",
      "uva-failed-login-{service}-{environment}",
      "uva-reboot-{service}-{environment}"
    ]
  },
  "identities": {
    "emails": ["ys2n@virginia.edu"],
    "phones": ["+14342826613"]
  },
  "filters": {
    "staging-pipelines": {
      "subscription_arn": "arn:aws:sns:us-east-1:115119339709:uva-infrastructure-notice-staging:8a96e853-5ef8-4a35-9017-6543c1278758",
      "field": "status",
      "prefixes": [
        "uva-drupal-dh-codepipeline",
        "uva-drupal-dsf-codepipeline",
        "uva-drupal-library-codepipeline",
        "uva-drupal-library-release-codepipeline",
        "uva-drupal-migrate-tools-codepipeline",
        "uva-drupal-netbadge-codepipeline",
        "uva-uva-drupal-theme-codepipeline"
      ]
    }
  }
}
